{
  "name": "tsprose-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun vitest run",
    "build": "bun run --filter '*' build",
    "format": "prettier --write .",
    "check": "bun run build && bun run typecheck && bun run test"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/node": "^25.3.0",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.0",
    "typescript": "7.1.0-beta",
    "vitest": "^4.1.0"
  }
}
