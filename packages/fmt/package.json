{
  "name": "@tsprose/fmt",
  "version": "2.0.0-alpha.0",
  "type": "module",
  "description": "Fast prose-aware formatter for TSProse TSX files: fills text by width, never breaks inline elements from their punctuation, keeps code outside JSX untouched.",
  "license": "MIT",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "bin": {
    "tsprose-fmt": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "test": "vitest run",
    "bench": "bun test/bench.ts"
  },
  "dependencies": {
    "oxc-parser": "^0.156.0",
    "@tsprose/transform": "workspace:*"
  },
  "peerDependencies": {
    "tsprose": "workspace:*",
    "oxfmt": ">=0.75.0"
  },
  "devDependencies": {
    "oxfmt": "0.75.0",
    "tsprose": "workspace:*"
  },
  "peerDependenciesMeta": {
    "oxfmt": {
      "optional": true
    }
  }
}
