{
  "name": "@tsprose/fmt",
  "version": "2.0.0-alpha.0",
  "type": "module",
  "description": "Fast prose-aware formatter for TSProse TSX files: fills text by width, never breaks inline elements from their punctuation, keeps code outside JSX untouched.",
  "license": "MIT",
  "author": "Gwynerva <the.gwynerva@gmail.com>",
  "homepage": "https://github.com/Gwynerva/tsprose/tree/v2/packages/fmt#readme",
  "bugs": {
    "url": "https://github.com/Gwynerva/tsprose/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Gwynerva/tsprose.git",
    "directory": "packages/fmt"
  },
  "keywords": [
    "tsprose",
    "formatter",
    "prose",
    "tsx",
    "jsx",
    "cli"
  ],
  "engines": {
    "node": ">=20",
    "bun": ">=1.2"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "tsprose-fmt": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "node ../../scripts/build-package.mjs",
    "test": "vitest run",
    "bench": "bun test/bench.ts",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "oxc-parser": "^0.156.0",
    "@tsprose/transform": "workspace:^"
  },
  "peerDependencies": {
    "oxfmt": ">=0.75.0"
  },
  "peerDependenciesMeta": {
    "oxfmt": {
      "optional": true
    }
  },
  "devDependencies": {
    "oxfmt": "0.75.0",
    "tsprose": "workspace:^"
  }
}
