{
  "name": "@tsprose/analyzer",
  "version": "2.0.0-alpha.0",
  "type": "module",
  "description": "Static checks for TSProse prose files: nesting, props, refs and whitespace. CLI (tsprose check) and an ESLint plugin.",
  "license": "MIT",
  "author": "Gwynerva <the.gwynerva@gmail.com>",
  "homepage": "https://github.com/Gwynerva/tsprose/tree/v2/packages/analyzer#readme",
  "bugs": {
    "url": "https://github.com/Gwynerva/tsprose/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Gwynerva/tsprose.git",
    "directory": "packages/analyzer"
  },
  "keywords": [
    "tsprose",
    "linter",
    "eslint-plugin",
    "static-analysis",
    "tsx",
    "cli"
  ],
  "engines": {
    "node": ">=20",
    "bun": ">=1.2"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "tsprose": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./eslint": {
      "types": "./dist/eslint/index.d.ts",
      "default": "./dist/eslint/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "node ../../scripts/build-package.mjs",
    "test": "vitest run",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "@tsprose/transform": "workspace:^",
    "oxc-parser": "^0.156.0"
  },
  "peerDependencies": {
    "eslint": ">=9",
    "tsprose": "workspace:^"
  },
  "peerDependenciesMeta": {
    "eslint": {
      "optional": true
    }
  },
  "devDependencies": {
    "eslint": "^9.0.0",
    "tsprose": "workspace:^"
  }
}
