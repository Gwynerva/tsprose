{
  "name": "tsprose",
  "version": "2.0.0-alpha.0",
  "type": "module",
  "description": "Write and structure prose in TypeScript TSX with strong typing: schema-first tags, typed documents, cross references and a compile pipeline.",
  "license": "MIT",
  "author": "Gwynerva <the.gwynerva@gmail.com>",
  "homepage": "https://github.com/Gwynerva/tsprose/tree/v2/packages/tsprose#readme",
  "bugs": {
    "url": "https://github.com/Gwynerva/tsprose/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Gwynerva/tsprose.git",
    "directory": "packages/tsprose"
  },
  "keywords": [
    "prose",
    "typescript",
    "tsx",
    "jsx",
    "markup",
    "document",
    "crossref",
    "cross-reference",
    "transclusion",
    "schema"
  ],
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./internal": {
      "types": "./dist/internal.d.ts",
      "default": "./dist/internal.js"
    },
    "./jsx-runtime": {
      "types": "./dist/jsx-runtime.d.ts",
      "default": "./dist/jsx-runtime.js"
    },
    "./jsx-dev-runtime": {
      "types": "./dist/jsx-dev-runtime.d.ts",
      "default": "./dist/jsx-dev-runtime.js"
    },
    "./externals": {
      "types": "./dist/externals.d.ts"
    },
    "./jsx-global": {
      "types": "./dist/jsx-global.d.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "node ../../scripts/build-package.mjs --copy src/externals.d.ts --copy src/jsx-global.d.ts",
    "test": "vitest run --config vitest.config.ts && vitest run --config vitest.registry.config.ts",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "@noble/hashes": "^2.0.0"
  },
  "devDependencies": {
    "@typescript/typescript6": "^6.0.2"
  }
}
