{
  "name": "vscode-tsprose",
  "version": "0.1.1",
  "private": true,
  "description": "Format TSProse prose files with @tsprose/fmt (fast, prose-aware) instead of Prettier.",
  "license": "MIT",
  "author": "Gwynerva <the.gwynerva@gmail.com>",
  "homepage": "https://github.com/Gwynerva/tsprose/tree/v2/packages/vscode-tsprose#readme",
  "bugs": {
    "url": "https://github.com/Gwynerva/tsprose/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Gwynerva/tsprose.git",
    "directory": "packages/vscode-tsprose"
  },
  "keywords": [
    "tsprose",
    "formatter",
    "prose",
    "tsx"
  ],
  "engines": {
    "vscode": "^1.90.0"
  },
  "publisher": "tsprose",
  "displayName": "TSProse",
  "categories": [
    "Formatters"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onLanguage:typescriptreact",
    "onLanguage:javascriptreact"
  ],
  "contributes": {
    "configuration": {
      "title": "TSProse",
      "properties": {
        "tsprose.fmt.command": {
          "type": "string",
          "default": "bunx tsprose-fmt",
          "description": "Command that runs the formatter (receives --stdin --stdin-filepath <file> [--config <cfg>])."
        },
        "tsprose.fmt.config": {
          "type": "string",
          "default": "",
          "description": "Path to the formatter config (tsprose.config.ts or a JSON tags description): absolute, or relative to the workspace folder (to the document's folder outside a workspace). Empty: no config."
        },
        "tsprose.fmt.files": {
          "type": "string",
          "default": "**/content/**/*.tsx",
          "description": "Glob (relative to the workspace folder; matched against the full path outside a workspace) of prose files the formatter handles. The default follows the convention of keeping prose under a content/ folder. Other TSX files are left to your default formatter."
        }
      }
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "esbuild src/extension.ts --bundle --platform=node --external:vscode --format=cjs --outfile=dist/extension.js",
    "test": "vitest run",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/vscode": "~1.90.0",
    "@vscode/vsce": "^3.6.0",
    "esbuild": "^0.28.2"
  }
}
